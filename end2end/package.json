{
    "name": "origa-e2e",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "trailbase:start": "cd trailbase-fixture && trail run --dev --address 127.0.0.1:4000",
        "trailbase:stop": "taskkill /f /im trail.exe 2>nul || true",
        "test": "playwright test",
        "pretest": "bddgen",
        "typecheck": "tsc --noEmit",
        "bdd:gen": "bddgen",
        "test:bdd": "bddgen && playwright test --project=bdd",
        "test:ui": "playwright test --ui",
        "test:headed": "playwright test --headed",
        "test:debug": "playwright test --debug",
        "report": "playwright show-report --host 0.0.0.0 --port 9323"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@types/node": "^26.2.0",
        "eslint": "^10.8.1",
        "playwright-bdd": "^9.2.0",
        "serve": "^14.2.6",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.67.0"
    },
    "dependencies": {
        "dotenv": "^17.4.2"
    }
}
