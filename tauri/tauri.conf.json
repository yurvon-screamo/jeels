{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Origa",
    "version": "0.1.0",
    "identifier": "net.uwuwu.origa",
    "build": {
        "beforeDevCommand": {
            "script": "trunk serve",
            "cwd": "../origa_ui"
        },
        "devUrl": "http://localhost:1420",
        "frontendDist": "../origa_ui/dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "Origa 「オリガ」",
                "width": 800,
                "height": 600,
                "additionalBrowserArgs": "--enable-unsafe-webgpu"
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.pyke.io; connect-src 'self' ipc: http://ipc.localhost https://s3.origa.uwuwu.net https://origa.uwuwu.net https://app.origa.uwuwu.net https://huggingface.co https://signal.pyke.io https://cdn.pyke.io; img-src 'self' data: blob: https://s3.origa.uwuwu.net; media-src 'self' blob: https://s3.origa.uwuwu.net; style-src 'self' 'unsafe-inline'; font-src 'self' https://s3.origa.uwuwu.net; form-action 'self' https://accounts.google.com https://oauth.yandex.ru; frame-ancestors 'none'"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": true,
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": {
            "gen/apple/PrivacyInfo.xcprivacy": "PrivacyInfo.xcprivacy"
        },
        "android": {},
        "iOS": {
            "minimumSystemVersion": "26.0"
        },
        "macOS": {
            "entitlements": "Entitlements.plist",
            "minimumSystemVersion": "13.0",
            "infoPlist": "MacOS-Info.plist"
        }
    },
    "plugins": {
        "opener": {},
        "deep-link": {
            "desktop": {
                "schemes": ["origa"]
            },
            "mobile": [
                {
                    "scheme": ["origa"],
                    "appLink": false
                }
            ]
        },
        "updater": {
            "endpoints": [
                "https://github.com/yurvon-screamo/origa/releases/latest/download/latest.json"
            ],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxN0Y5QzY3MURBMDRCOUQKUldTZFM2QWRaNXgvNFpZUUJTWkFtOXkyOUVYMFZQRXBiUVN2cXBrZFZ6aTNNZmdPazVFNHUyRjcK"
        }
    }
}
